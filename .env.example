# ── ADE Platform Configuration ──────────────────────────────────────
APP_NAME=ADE Platform
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Data paths (relative to project root)
DATA_DIR=backend/data
PDF_DIR=backend/data/pdfs
OUTPUT_DIR=backend/data/outputs
SCHEMA_DIR=backend/data/schemas

# AI Provider Selection: openai | anthropic | gemini | ollama | landingai | custom | none
AI_PROVIDER=anthropic

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LandingAI
LANDINGAI_API_KEY=ZjZxbWRsemwzYXNvYm9zdGNicnllOmF5R0xFVHhBNTlrN0p6Z1BCbEdEM1RpVWVWS1NqWXA2
LANDINGAI_ENDPOINT=https://va.landing.ai/my/home

# Batch settings
BATCH_MAX_WORKERS=4
BATCH_TIMEOUT_PER_FILE=120

# AI timeouts
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2
